{
  "name": "paseo-codex-multi-account",
  "version": "0.1.0",
  "description": "Manage Codex/ChatGPT accounts in independent homes with per-agent selection and subscription usage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketitongxue/paseo-codex-multi-account.git"
  },
  "homepage": "https://github.com/ketitongxue/paseo-codex-multi-account#readme",
  "bugs": {
    "url": "https://github.com/ketitongxue/paseo-codex-multi-account/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "paseo-plugin.json",
    "index.server.ts",
    "index.client.tsx",
    "server",
    "client",
    "shared",
    "docs",
    "assets",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "npm-shrinkwrap.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "lint": "biome check index.server.ts index.client.tsx server client shared tests scripts",
    "format": "biome check --write index.server.ts index.client.tsx server client shared tests scripts",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke:homes": "tsx scripts/check-homes.ts",
    "smoke:codex": "tsx scripts/smoke-codex.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "prepack": "npm run typecheck"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@getpaseo/client": "0.14.0-beta.1",
    "@getpaseo/plugin": "0.14.0-beta.1",
    "@getpaseo/protocol": "0.14.0-beta.1",
    "@getpaseo/server": "0.14.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "0.28.2",
    "pino": "^10.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.4",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "zod": "^4.4.3"
  }
}
