{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node", "react"], "resolveJsonModule": true
  },
  "include": ["index.*", "client", "server", "shared", "tests", "scripts"],
  "exclude": ["node_modules", ".research"]
}
